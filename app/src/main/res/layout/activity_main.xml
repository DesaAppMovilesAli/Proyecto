<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/plant_beige"
    tools:context=".MainActivity">


    <LinearLayout

        android:id="@+id/mainContent"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/bottomNavigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Application title -->

        <TextView
            android:id="@+id/textView1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_nam"
            android:textSize="34sp"
            android:textStyle="bold"
            android:textColor="@color/plant_green_dark"
            android:gravity="center"/>

        <!-- Home title -->

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:text="@string/title_home"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/plant_green_dark"/>

        <!-- Search and filter -->

        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="0">

            <TableRow
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <EditText
                    android:id="@+id/etSearchPlant"
                    android:layout_width="0dp"
                    android:layout_height="55dp"
                    android:hint="@string/search_plant"
                    android:inputType="text"
                    android:singleLine="true"
                    android:padding="10dp"
                    android:backgroundTint="@color/plant_green"
                    android:textColor="@color/plant_green_dark"
                    android:textColorHint="@color/plant_gray"/>

                <Button
                    android:id="@+id/btnFilters"
                    android:layout_width="wrap_content"
                    android:layout_height="55dp"
                    android:layout_marginStart="8dp"
                    android:text="@string/title_filters"
                    android:textSize="12sp"
                    android:textAllCaps="false"
                    android:backgroundTint="@color/plant_pink"
                    android:textColor="@color/plant_green_dark"/>

            </TableRow>
        </TableLayout>

        <!-- Plants section -->

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="20dp"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/plantContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/textView3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/no_data_found"
                    android:textSize="17sp"
                    android:textColor="@color/plant_gray"
                    android:gravity="center"/>

            </LinearLayout>

        </ScrollView>

        <!-- Add plant -->

        <Button
            android:id="@+id/btnAddPlant"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="12dp"
            android:text="@string/add_plant"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:backgroundTint="@color/plant_green"
            android:textColor="@color/plant_white"/>

    </LinearLayout>

    <!-- Bottom navigation -->

    <TableLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/plant_green_light"
        android:padding="8dp"
        android:stretchColumns="*"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TableRow
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnHome"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_home"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/plant_green"
                android:textColor="@color/plant_white"/>

            <Button
                android:id="@+id/btnMap"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/title_map"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/plant_pink"
                android:textColor="@color/plant_green_dark"/>

            <Button
                android:id="@+id/btnProfile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/btn_profile"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:backgroundTint="@color/plant_pink"
                android:textColor="@color/plant_green_dark"/>

        </TableRow>
    </TableLayout>



</androidx.constraintlayout.widget.ConstraintLayout>